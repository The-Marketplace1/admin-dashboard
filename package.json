{
  "name": "marketplace-analytics",
  "version": "1.0.0",
  "private": true,
  "description": "Marketplace product analytics service with privacy-aware event processing and reporting.",
  "type": "module",
  "exports": {
    "./app": {
      "types": "./dist/src/app/index.d.ts",
      "import": "./dist/src/app/index.js"
    },
    "./contracts": {
      "types": "./dist/src/public.d.ts",
      "import": "./dist/src/public.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "lint": "eslint src tests scripts/validate-repository.mjs eslint.config.js vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "security": "pnpm audit --audit-level=high",
    "validate": "pnpm run lint && pnpm run typecheck && pnpm test && pnpm run security && pnpm run build && node scripts/validate-repository.mjs"
  },
  "dependencies": {
    "express": "^5.2.1",
    "pino": "^9.14.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.3",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8",
    "vitest": "^4.1.11"
  }
}
